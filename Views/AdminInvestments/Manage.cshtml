@model MoneyMiners.ViewModels.Admin.ManageInvestorInvestmentsViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Manage Investments";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="mm-admin-header">

        <div>

            <span class="mm-admin-label">
                INVESTMENT MANAGEMENT
            </span>

            <h1>
                @Model.InvestorName
            </h1>

            <p>
                Review and manage all investments
                for investor @Model.InvestorCode.
            </p>

        </div>

        <div class="mm-admin-count">

            <small>
                Active Plans
            </small>

            <strong>
                @Model.ActiveInvestmentCount
            </strong>

        </div>

    </div>


    <!-- Success Message -->
    @if (TempData["InvestmentSuccess"] is string successMessage)
    {
        <div class="alert alert-success mt-3"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @successMessage

        </div>
    }


    <!-- Error Message -->
    @if (TempData["InvestmentError"] is string errorMessage)
    {
        <div class="alert alert-danger mt-3"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @errorMessage

        </div>
    }


    <!-- Toolbar -->
    <div class="mm-admin-users-toolbar">

        <a asp-controller="Investors"
           asp-action="Index"
           class="mm-admin-reset-button">

            <i class="bi bi-arrow-left"></i>
            Back to Investors

        </a>

        <a asp-controller="AdminInvestments"
           asp-action="Assign"
           asp-route-investorCode="@Model.InvestorCode"
           class="mm-admin-filter-button">

            <i class="bi bi-plus-circle"></i>
            Assign New Investment

        </a>

    </div>


        <!-- Investor Summary -->
        <div class="row g-4 mb-4">

            <div class="col-md-6 col-xl-3">

                <div class="mm-admin-table-card h-100 p-4">

                    <small class="mm-admin-label">
                        INVESTOR ID
                    </small>

                    <h4 class="mt-2 mb-0">
                        @Model.InvestorCode
                    </h4>

                </div>

            </div>


            <div class="col-md-6 col-xl-3">

                <div class="mm-admin-table-card h-100 p-4">

                    <small class="mm-admin-label">
                        ACTIVE INVESTMENT
                    </small>

                    <h4 class="mt-2 mb-0">
                        ₹@Model.TotalActiveInvestment.ToString("N2")
                    </h4>

                </div>

            </div>


            <div class="col-md-6 col-xl-3">

                <div class="mm-admin-table-card h-100 p-4">

                    <small class="mm-admin-label">
                        MOBILE
                    </small>

                    <h5 class="mt-2 mb-2">
                        @Model.PhoneNumber
                    </h5>

                    @if (Model.IsMobileVerified)
                    {
                        <span class="mm-admin-account-status is-active">
                            Verified
                        </span>
                    }
                    else
                    {
                        <span class="mm-admin-account-status is-inactive">
                            Unverified
                        </span>
                    }

                </div>

            </div>


            <div class="col-md-6 col-xl-3">

                <div class="mm-admin-table-card h-100 p-4">

                    <small class="mm-admin-label">
                        ACCOUNT STATUS
                    </small>

                    <div class="mt-3">

                        <span class="mm-admin-account-status
                            @(Model.IsActive
                                ? "is-active"
                                : "is-inactive")">

                            @(Model.IsActive
                                ? "Active"
                                : "Inactive")

                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Investments -->
        <div class="mm-admin-table-card">

            @if (Model.Investments.Count == 0)
            {
                <div class="mm-admin-empty">

                    <i class="bi bi-wallet2"></i>

                    <h2>
                        No Investments Found
                    </h2>

                    <p>
                        This investor does not have
                        any investment records yet.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table mm-admin-table">

                        <thead>

                            <tr>
                                <th>Investment ID</th>
                                <th>Plan</th>
                                <th>Amount</th>
                                <th>Duration</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Status</th>
                                <th>Payment Ref.</th>
                                <th>Created</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var investment in Model.Investments)
                            {
                                <tr>

                                    <td>

                                        <span class="mm-admin-id">
                                            @investment.InvestmentCode
                                        </span>

                                    </td>

                                    <td>

                                        <strong>
                                            @investment.PlanName
                                        </strong>

                                    </td>

                                    <td>

                                        <strong>
                                            ₹@investment.InvestedAmount.ToString("N2")
                                        </strong>

                                    </td>

                                    <td>
                                        @investment.DurationMonths Months
                                    </td>

                                    <td>
                                        @investment.StartDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @investment.EndDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>

                                        @if (investment.Status == "Active")
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else if (investment.Status == "Settled")
                                        {
                                            <span class="badge bg-primary">
                                                Settled
                                            </span>
                                        }
                                        else if (investment.Status == "Closed")
                                        {
                                            <span class="badge bg-secondary">
                                                Closed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                @investment.Status
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(
                                            investment.PaymentReference))
                                        {
                                            <span class="text-muted">
                                                —
                                            </span>
                                        }
                                        else
                                        {
                                            @investment.PaymentReference
                                        }

                                    </td>

                                    <td>

                                        @(investment.CreatedAtUtc
                                            .ToLocalTime()
                                            .ToString("dd MMM yyyy"))

                                    </td>

                                    <td>

                                        @if (investment.Status == "Active")
                                        {
                                            <div class="d-flex flex-column gap-2">

                                                <!-- Settled -->
                                                <form asp-controller="AdminInvestments"
                                                      asp-action="ChangeStatus"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="investmentId"
                                                           value="@investment.InvestmentID" />

                                                    <input type="hidden"
                                                           name="investorCode"
                                                           value="@Model.InvestorCode" />

                                                    <input type="hidden"
                                                           name="newStatus"
                                                           value="Settled" />

                                                    <input type="hidden"
                                                           name="remarks"
                                                           value="" />

                                                    <button type="submit"
                                                            class="btn btn-success btn-sm w-100"
                                                            onclick="
                                                        var note=prompt('Optional settlement note for @investment.InvestmentCode ( @investment.PlanName Plan):');
                                                        if (note===null) {
                                                        note='' ;
                                                        }
                                                        note=note.trim();
                                                        if (note.length>
                                                        500) {
                                                        alert('Settlement note cannot exceed 500 characters.');
                                                        return false;
                                                        }

                                                        this.form.querySelector('input[name=&quot;remarks&quot;]').value = note;

                                                        return confirm('Settle @investment.InvestmentCode (@investment.PlanName Plan)? This action will move it to Investment History.');
                                                        ">
                                                        Settled
                                                    </button>

                                                </form>


                                                <!-- Closed -->
                                                <form asp-controller="AdminInvestments"
                                                      asp-action="ChangeStatus"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="investmentId"
                                                           value="@investment.InvestmentID" />

                                                    <input type="hidden"
                                                           name="investorCode"
                                                           value="@Model.InvestorCode" />

                                                    <input type="hidden"
                                                           name="newStatus"
                                                           value="Closed" />

                                                    <input type="hidden"
                                                           name="remarks"
                                                           value="" />

                                                    <button type="submit"
                                                            class="btn btn-secondary btn-sm w-100"
                                                            onclick="
                                                        var reason=prompt('Enter closure reason for @investment.InvestmentCode ( @investment.PlanName Plan):');
                                                        if (reason===null) {
                                                        return false;
                                                        }
                                                        reason=reason.trim();
                                                        if (reason.length===0) {
                                                        alert('Closure reason is required.');
                                                        return false;
                                                        }
                                                        if (reason.length>
                                                        500) {
                                                        alert('Closure reason cannot exceed 500 characters.');
                                                        return false;
                                                        }

                                                        this.form.querySelector('input[name=&quot;remarks&quot;]').value = reason;

                                                        return confirm('Close @investment.InvestmentCode (@investment.PlanName Plan)? This action will move it to Investment History.');
                                                        ">
                                                        Closed
                                                    </button>

                                                </form>


                                                <!-- Cancelled -->
                                                <form asp-controller="AdminInvestments"
                                                      asp-action="ChangeStatus"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="investmentId"
                                                           value="@investment.InvestmentID" />

                                                    <input type="hidden"
                                                           name="investorCode"
                                                           value="@Model.InvestorCode" />

                                                    <input type="hidden"
                                                           name="newStatus"
                                                           value="Cancelled" />

                                                    <input type="hidden"
                                                           name="remarks"
                                                           value="" />

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm w-100"
                                                            onclick="
                                                        var reason=prompt('Enter cancellation reason for @investment.InvestmentCode ( @investment.PlanName Plan):');
                                                        if (reason===null) {
                                                        return false;
                                                        }
                                                        reason=reason.trim();
                                                        if (reason.length===0) {
                                                        alert('Cancellation reason is required.');
                                                        return false;
                                                        }
                                                        if (reason.length>
                                                        500) {
                                                        alert('Cancellation reason cannot exceed 500 characters.');
                                                        return false;
                                                        }

                                                        this.form.querySelector('input[name=&quot;remarks&quot;]').value = reason;

                                                        return confirm('Cancel @investment.InvestmentCode (@investment.PlanName Plan)? This action will move it to Investment History.');
                                                        ">
                                                        Cancelled
                                                    </button>

                                                </form>

                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No action
                                            </span>
                                        }

                                    </td>


                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</section>