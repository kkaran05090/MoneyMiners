@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Admin Dashboard";

    var isSuperAdmin =
        User.IsInRole("SuperAdmin");

    var displayName =
        User.Identity?.Name ?? "Administrator";
}

<section class="mm-admin-page">
    <div class="container-fluid">

        <div class="mm-dashboard-hero">

            <div>
                <span class="mm-admin-label">
                    @(isSuperAdmin
                        ? "SUPERADMIN PORTAL"
                        : "ADMIN PORTAL")
                </span>

                <h1>
                    Welcome, @displayName
                </h1>

                <p>
                    Manage Money Miners operations securely from
                    your role-based administration dashboard.
                </p>
            </div>

            <div class="mm-dashboard-role-card">

                <small>Signed in as</small>

                <strong>
                    @(isSuperAdmin
                        ? "SuperAdmin"
                        : "Admin")
                </strong>

                <span>
                    Secure session active
                </span>

            </div>

        </div>

        <div class="mm-dashboard-grid">

            <a asp-controller="Admin"
               asp-action="Index"
               class="mm-dashboard-card">

                <div class="mm-dashboard-card-icon">
                    <i class="bi bi-envelope-paper"></i>
                </div>

                <div>
                    <span class="mm-dashboard-card-label">
                        COMMUNICATION
                    </span>

                    <h2>Contact Messages</h2>

                    <p>
                        Review investor enquiries, update statuses
                        and manage submitted messages.
                    </p>
                </div>

                <span class="mm-dashboard-card-action">
                    Open Messages
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>

            @if (isSuperAdmin)
            {
                <a asp-controller="AdminUsers"
                   asp-action="Index"
                   class="mm-dashboard-card">

                    <div class="mm-dashboard-card-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <div>
                        <span class="mm-dashboard-card-label">
                            SUPERADMIN CONTROL
                        </span>

                        <h2>Admin Management</h2>

                        <p>
                            Create, review and manage administrator
                            accounts and access.
                        </p>
                    </div>

                    <span class="mm-dashboard-card-action">
                        Manage Admins
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </a>
            }

            <a asp-controller="Investors"
               asp-action="Index"
               class="mm-dashboard-card">

                <div class="mm-dashboard-card-icon">
                    <i class="bi bi-person-vcard"></i>
                </div>

                <div>
                    <span class="mm-dashboard-card-label">
                        INVESTOR OPERATIONS
                    </span>

                    <h2>Investors</h2>

                    <p>
                        Review investor profiles, account details
                        and verification activity.
                    </p>
                </div>

                <span class="mm-dashboard-card-arrow">
                    <i class="bi bi-arrow-right"></i>
                </span>

            </a>

            <article class="mm-dashboard-card is-coming-soon">

                <div class="mm-dashboard-card-icon">
                    <i class="bi bi-wallet2"></i>
                </div>

                <div>
                    <span class="mm-dashboard-card-label">
                        FINANCIAL OPERATIONS
                    </span>

                    <h2>Payments</h2>

                    <p>
                        Track deposits, withdrawals and transaction
                        approval workflows.
                    </p>
                </div>

                <span class="mm-dashboard-coming-badge">
                    Coming Soon
                </span>

            </article>

            <article class="mm-dashboard-card is-coming-soon">

                <div class="mm-dashboard-card-icon">
                    <i class="bi bi-bar-chart-line"></i>
                </div>

                <div>
                    <span class="mm-dashboard-card-label">
                        BUSINESS INSIGHTS
                    </span>

                    <h2>Reports</h2>

                    <p>
                        Review platform performance, investor activity
                        and operational reports.
                    </p>
                </div>

                <span class="mm-dashboard-coming-badge">
                    Coming Soon
                </span>

            </article>

            @if (isSuperAdmin)
            {
                <article class="mm-dashboard-card is-coming-soon">

                    <div class="mm-dashboard-card-icon">
                        <i class="bi bi-gear"></i>
                    </div>

                    <div>
                        <span class="mm-dashboard-card-label">
                            SYSTEM CONTROL
                        </span>

                        <h2>Settings</h2>

                        <p>
                            Manage platform configuration, security
                            policies and administration settings.
                        </p>
                    </div>

                    <span class="mm-dashboard-coming-badge">
                        Coming Soon
                    </span>

                </article>
            }

        </div>

    </div>
</section>
