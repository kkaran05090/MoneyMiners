@model MoneyMiners.ViewModels.Investor.InvestorResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<section class="mm-investor-auth-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-5 col-lg-6 col-md-8">

                <div class="mm-investor-auth-card">

                    <div class="card-body p-4 p-md-5">

                        <div class="mm-investor-auth-header">

                            <div class="mm-investor-auth-icon">
                                <i class="bi bi-key"></i>
                            </div>

                            <span class="mm-investor-auth-kicker">
                                Secure Account Recovery
                            </span>

                            <h1 class="mm-investor-auth-title">
                                Reset Password
                            </h1>

                            <p class="mm-investor-auth-copy">
                                Create a strong new password for your
                                investor account.
                            </p>

                        </div>

                        <form asp-controller="InvestorAccount"
                              asp-action="ResetPassword"
                              method="post"
                              class="mm-investor-auth-form">

                            <input asp-for="InvestorOtpChallengeID"
                                   type="hidden" />

                            <input asp-for="PhoneNumber"
                                   type="hidden" />

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger mb-4">
                            </div>

                            <div class="mb-3">

                                <label asp-for="NewPassword"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-lock"></i>
                                    </span>

                                    <input asp-for="NewPassword"
                                           class="form-control"
                                           autocomplete="new-password"
                                           placeholder="Enter new password" />

                                </div>

                                <span asp-validation-for="NewPassword"
                                      class="text-danger">
                                </span>

                            </div>

                            <div class="mb-4">

                                <label asp-for="ConfirmPassword"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-shield-lock"></i>
                                    </span>

                                    <input asp-for="ConfirmPassword"
                                           class="form-control"
                                           autocomplete="new-password"
                                           placeholder="Confirm new password" />

                                </div>

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger">
                                </span>

                            </div>

                            <button type="submit"
                                    class="btn mm-investor-auth-primary w-100">

                                Reset Password
                                <i class="bi bi-check-circle ms-2"></i>

                            </button>

                            <div class="mm-investor-auth-security mt-4">

                                <i class="bi bi-shield-check"></i>

                                <p>
                                    Your new password will be securely hashed.
                                    Your previous login lockout will also be cleared.
                                </p>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}