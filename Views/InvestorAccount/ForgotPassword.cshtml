@model MoneyMiners.ViewModels.Investor.InvestorForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<section class="mm-investor-auth-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-5 col-lg-6 col-md-8">

                <div class="mm-investor-auth-card">

                    <div class="card-body p-4 p-md-5">

                        <div class="mm-investor-auth-header">

                            <div class="mm-investor-auth-icon">
                                <i class="bi bi-shield-lock"></i>
                            </div>

                            <span class="mm-investor-auth-kicker">
                                Account Recovery
                            </span>

                            <h1 class="mm-investor-auth-title">
                                Forgot Password
                            </h1>

                            <p class="mm-investor-auth-copy">
                                Enter your registered email address to receive
                                a secure password reset OTP.
                            </p>

                        </div>

                        <form asp-controller="InvestorAccount"
                              asp-action="ForgotPassword"
                              method="post"
                              class="mm-investor-auth-form">

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger mb-4">
                            </div>

                            <div class="mb-4">

                                <label asp-for="Email"
                                       class="form-label">
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        <i class="bi bi-envelope-fill"></i>
                                    </span>

                                    <input asp-for="Email"
                                           class="form-control"
                                           type="email"
                                           autocomplete="email"
                                           placeholder="Enter your registered email address" />

                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger">
                                </span>

                                <div class="form-text mt-2">
                                    A six-digit password reset OTP will be sent
                                    to your registered email address.
                                </div>

                            </div>

                            <button type="submit"
                                    class="btn mm-investor-auth-primary w-100">

                                Send OTP
                                <i class="bi bi-arrow-right ms-2"></i>

                            </button>

                            <hr class="mm-investor-auth-divider" />

                            <div class="text-center">

                                <a asp-controller="InvestorAccount"
                                   asp-action="Login"
                                   class="mm-investor-auth-link">

                                    <i class="bi bi-arrow-left me-1"></i>
                                    Back to Login

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}