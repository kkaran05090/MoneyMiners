@model MoneyMiners.ViewModels.Investor.InvestorForgotPasswordOtpViewModel

@{
    ViewData["Title"] = "Verify OTP";

    var emailAddress =
        Model.EmailAddress ?? string.Empty;

    var emailParts =
        emailAddress.Split('@');

    var maskedEmail =
        emailAddress;

    if (emailParts.Length == 2 &&
        emailParts[0].Length > 2)
    {
        maskedEmail =
            $"{emailParts[0][..2]}***@{emailParts[1]}";
    }
}

<section class="mm-investor-auth-page">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-xl-5 col-lg-6 col-md-8">

                <div class="mm-investor-auth-card">

                    <div class="card-body p-4 p-md-5">

                        <div class="mm-investor-auth-header">

                            <div class="mm-investor-auth-icon">
                                <i class="bi bi-envelope-fill"></i>
                            </div>

                            <span class="mm-investor-auth-kicker">
                                Security Verification
                            </span>

                            <h1 class="mm-investor-auth-title">
                                Verify OTP
                            </h1>

                            <p class="mm-investor-auth-copy">
                                Enter the 6-digit OTP sent to
                                <strong class="text-white">
                                    @maskedEmail
                                </strong>
                            </p>

                        </div>

                        <form asp-controller="InvestorAccount"
                              asp-action="VerifyForgotPasswordOtp"
                              method="post"
                              class="mm-investor-auth-form">

                            @Html.AntiForgeryToken()

                            <input asp-for="InvestorEmailOtpChallengeID"
                                   type="hidden" />

                            <input asp-for="EmailAddress"
                                   type="hidden" />

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger mb-4">
                            </div>

                            <div class="mb-4">

                                <label asp-for="OtpCode"
                                       class="form-label">
                                </label>

                                <input asp-for="OtpCode"
                                       class="form-control mm-investor-otp-input"
                                       maxlength="6"
                                       inputmode="numeric"
                                       autocomplete="one-time-code"
                                       placeholder="000000" />

                                <span asp-validation-for="OtpCode"
                                      class="text-danger">
                                </span>

                                <div class="form-text text-center mt-3">
                                    OTP is valid for 5 minutes.
                                    Maximum 5 attempts are allowed.
                                </div>

                            </div>

                            <button type="submit"
                                    class="btn mm-investor-auth-primary w-100">

                                Verify OTP
                                <i class="bi bi-shield-check ms-2"></i>

                            </button>

                            <hr class="mm-investor-auth-divider" />

                            <div class="text-center">

                                <a asp-action="ForgotPassword"
                                   class="mm-investor-auth-link">

                                    <i class="bi bi-arrow-left me-1"></i>
                                    Change Email Address

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}