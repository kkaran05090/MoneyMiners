                            <div class="col-md-6">

                                <label asp-for="FullName"
                                       class="form-label">
                                </label>

                                <input asp-for="FullName"
                                       class="form-control"
                                       placeholder="Enter your name" />

                                <span asp-validation-for="FullName"
                                      class="text-danger">
                                </span>

