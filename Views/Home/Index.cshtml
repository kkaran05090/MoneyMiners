@model MoneyMiners.Models.ContactMessage
@using Microsoft.AspNetCore.Authentication
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Home";

    var whatsappNumber =
        Configuration["WhatsApp:BusinessNumber"];

    var investorAuthentication =
        await Context.AuthenticateAsync("InvestorCookie");

    var investorCode =
        investorAuthentication.Succeeded
            ? investorAuthentication.Principal?
                .FindFirst("InvestorCode")?.Value
            : null;

    var investorIdLine =
        !string.IsNullOrWhiteSpace(investorCode)
            ? $"\nInvestor ID: {investorCode}\n"
            : string.Empty;

    var silverMessage = Uri.EscapeDataString(
        "Hello Money Miners,\n\n" +
        "I am interested in the Silver Investment Plan.\n" +
        investorIdLine +
        "\nPlease guide me regarding the investment process and payment.");

    var goldMessage = Uri.EscapeDataString(
        "Hello Money Miners,\n\n" +
        "I am interested in the Gold Investment Plan.\n" +
        investorIdLine +
        "\nPlease guide me regarding the investment process and payment.");

    var platinumMessage = Uri.EscapeDataString(
        "Hello Money Miners,\n\n" +
        "I am interested in the Platinum Investment Plan.\n" +
        investorIdLine +
        "\nPlease guide me regarding the investment process and payment.");

    var silverWhatsAppUrl =
        $"https://wa.me/{whatsappNumber}?text={silverMessage}";

    var goldWhatsAppUrl =
        $"https://wa.me/{whatsappNumber}?text={goldMessage}";

    var platinumWhatsAppUrl =
        $"https://wa.me/{whatsappNumber}?text={platinumMessage}";
}

