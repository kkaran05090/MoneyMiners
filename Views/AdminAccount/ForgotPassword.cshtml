@model MoneyMiners.ViewModels.Admin.AdminForgotPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Forgot Password";
}

<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<title>
    @ViewData["Title"] - Money Miners
</title>

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="~/css/theme.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/admin-login.css"
      asp-append-version="true" />


<main class="mm-admin-login-wrapper">

    <section class="mm-admin-login-card">

        <div class="mm-admin-login-brand">

            <div class="mm-admin-login-logo">
                MM
            </div>

            <div>
                <span>Money Miners</span>
                <small>Secure Administration</small>
            </div>

        </div>


        <div class="mm-admin-login-heading">

            <span class="mm-admin-login-label">
                PASSWORD RECOVERY
            </span>

            <h1>
                Forgot password?
            </h1>

            <p>
                Enter your registered email address.
                We will send a verification OTP to continue.
            </p>

        </div>


        <form asp-controller="AdminAccount"
              asp-action="ForgotPassword"
              method="post"
              class="mm-admin-login-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="mm-admin-login-validation">
            </div>


            <div class="mm-admin-login-field">

                <label asp-for="Email">
                </label>

                <input asp-for="Email"
                       class="form-control"
                       type="email"
                       inputmode="email"
                       autocomplete="email"
                       maxlength="256"
                       placeholder="Enter registered email address"
                       autofocus />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <button type="submit"
                    class="mm-admin-login-button">
                Send OTP
            </button>

        </form>


        <div class="text-center mt-3">

            <a asp-controller="AdminAccount"
               asp-action="Login"
               class="text-decoration-none">
                Back to Admin Login
            </a>

        </div>


        <p class="mm-admin-login-footer">
            OTP will only be sent to a registered
            administrator email address.
        </p>

    </section>

</main>

<partial name="_ValidationScriptsPartial" />