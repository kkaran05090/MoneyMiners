@model MoneyMiners.ViewModels.Admin.AdminResetPasswordViewModel

@{
    Layout = null;
    ViewData["Title"] = "Reset Password";

    var emailAddress =
        Model.EmailAddress ?? string.Empty;

    var emailParts =
        emailAddress.Split('@');

    var maskedEmail =
        emailAddress;

    if (emailParts.Length == 2 &&
        emailParts[0].Length > 2)
    {
        maskedEmail =
            $"{emailParts[0][..2]}***@{emailParts[1]}";
    }
}

<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<title>
    @ViewData["Title"] - Money Miners
</title>

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="~/css/theme.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/admin-login.css"
      asp-append-version="true" />


<main class="mm-admin-login-wrapper">

    <section class="mm-admin-login-card">

        <div class="mm-admin-login-brand">

            <div class="mm-admin-login-logo">
                MM
            </div>

            <div>
                <span>Money Miners</span>
                <small>Secure Administration</small>
            </div>

        </div>


        <div class="mm-admin-login-heading">

            <span class="mm-admin-login-label">
                RESET PASSWORD
            </span>

            <h1>
                Create new password
            </h1>

            <p>
                Create a new password for
                <strong>@maskedEmail</strong>.
            </p>

        </div>


        <form asp-controller="AdminAccount"
              asp-action="ResetPassword"
              method="post"
              class="mm-admin-login-form">

            @Html.AntiForgeryToken()

            <input asp-for="ChallengeID"
                   type="hidden" />

            <input asp-for="AdminUserID"
                   type="hidden" />

            <input asp-for="EmailAddress"
                   type="hidden" />


            <div asp-validation-summary="ModelOnly"
                 class="mm-admin-login-validation">
            </div>


            <div class="mm-admin-login-field">

                <label asp-for="NewPassword">
                </label>

                <div class="mm-admin-password-wrapper">

                    <input asp-for="NewPassword"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Enter new password"
                           id="newAdminPassword" />

                    <button type="button"
                            class="mm-admin-password-toggle"
                            id="toggleNewPassword">
                        Show
                    </button>

                </div>

                <span asp-validation-for="NewPassword"
                      class="text-danger">
                </span>

            </div>


            <div class="mm-admin-login-field">

                <label asp-for="ConfirmPassword">
                </label>

                <div class="mm-admin-password-wrapper">

                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password"
                           placeholder="Confirm new password"
                           id="confirmAdminPassword" />

                    <button type="button"
                            class="mm-admin-password-toggle"
                            id="toggleConfirmPassword">
                        Show
                    </button>

                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>

            </div>


            <button type="submit"
                    class="mm-admin-login-button">
                Reset Password
            </button>

        </form>


        <p class="mm-admin-login-footer">
            After reset, sign in using your new password.
        </p>

    </section>

</main>

<partial name="_ValidationScriptsPartial" />


<script>
    const newPasswordInput =
        document.getElementById("newAdminPassword");

    const toggleNewPassword =
        document.getElementById("toggleNewPassword");

    toggleNewPassword.addEventListener(
        "click",
        function () {

            const hidden =
                newPasswordInput.type === "password";

            newPasswordInput.type =
                hidden ? "text" : "password";

            toggleNewPassword.textContent =
                hidden ? "Hide" : "Show";
        });


    const confirmPasswordInput =
        document.getElementById("confirmAdminPassword");

    const toggleConfirmPassword =
        document.getElementById("toggleConfirmPassword");

    toggleConfirmPassword.addEventListener(
        "click",
        function () {

            const hidden =
                confirmPasswordInput.type === "password";

            confirmPasswordInput.type =
                hidden ? "text" : "password";

            toggleConfirmPassword.textContent =
                hidden ? "Hide" : "Show";
        });
</script>