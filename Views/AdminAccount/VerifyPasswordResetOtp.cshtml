@model MoneyMiners.ViewModels.Admin.AdminVerifyPasswordResetOtpViewModel

@{
    Layout = null;
    ViewData["Title"] = "Verify OTP";

    var emailAddress =
        Model.EmailAddress ?? string.Empty;

    var emailParts =
        emailAddress.Split('@');

    var maskedEmail =
        emailAddress;

    if (emailParts.Length == 2 &&
        emailParts[0].Length > 2)
    {
        maskedEmail =
            $"{emailParts[0][..2]}***@{emailParts[1]}";
    }
}

<meta name="viewport"
      content="width=device-width, initial-scale=1.0" />

<title>
    @ViewData["Title"] - Money Miners
</title>

<link rel="stylesheet"
      href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet"
      href="~/css/theme.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/admin-login.css"
      asp-append-version="true" />


<main class="mm-admin-login-wrapper">

    <section class="mm-admin-login-card">

        <div class="mm-admin-login-brand">

            <div class="mm-admin-login-logo">
                MM
            </div>

            <div>
                <span>Money Miners</span>
                <small>Secure Administration</small>
            </div>

        </div>


        <div class="mm-admin-login-heading">

            <span class="mm-admin-login-label">
                OTP VERIFICATION
            </span>

            <h1>
                Verify OTP
            </h1>

            <p>
                Enter the 6-digit verification code sent to
                <strong>@maskedEmail</strong>.
            </p>

        </div>


        <form asp-controller="AdminAccount"
              asp-action="VerifyPasswordResetOtp"
              method="post"
              class="mm-admin-login-form">

            @Html.AntiForgeryToken()

            <input asp-for="ChallengeID"
                   type="hidden" />

            <input asp-for="AdminUserID"
                   type="hidden" />

            <input asp-for="EmailAddress"
                   type="hidden" />


            <div asp-validation-summary="ModelOnly"
                 class="mm-admin-login-validation">
            </div>


            <div class="mm-admin-login-field">

                <label asp-for="OtpCode">
                </label>

                <input asp-for="OtpCode"
                       class="form-control"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       maxlength="6"
                       placeholder="Enter 6-digit OTP"
                       autofocus />

                <span asp-validation-for="OtpCode"
                      class="text-danger">
                </span>

            </div>


            <button type="submit"
                    class="mm-admin-login-button">
                Verify OTP
            </button>

        </form>


        <div class="text-center mt-3">

            <a asp-controller="AdminAccount"
               asp-action="ForgotPassword"
               class="text-decoration-none">
                Request New OTP
            </a>

        </div>


        <p class="mm-admin-login-footer">
            OTP is valid for 5 minutes and can only be used once.
        </p>

    </section>

</main>

<partial name="_ValidationScriptsPartial" />