@model MoneyMiners.ViewModels.Admin.AdminMobileVerificationOtpViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Verify Mobile OTP";
}

<section class="mm-admin-page">
    <div class="container-fluid">

        <div class="mm-admin-header">
            <div>
                <span class="mm-admin-label">
                    ACCOUNT SECURITY
                </span>

                <h1>Verify Mobile OTP</h1>

                <p>
                    Enter the 6-digit OTP sent to your
                    registered mobile number.
                </p>
            </div>
        </div>


        <div class="mm-admin-table-card">
            <div class="p-4 p-md-5">

                <form asp-controller="AdminAccount"
                      asp-action="VerifyMobileOtp"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input asp-for="ChallengeID"
                           type="hidden" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>


                    <div class="mb-4">

                        <label asp-for="OtpCode"
                               class="form-label">
                        </label>

                        <input asp-for="OtpCode"
                               class="form-control"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="6"
                               placeholder="Enter 6-digit OTP"
                               autofocus />

                        <span asp-validation-for="OtpCode"
                              class="text-danger small">
                        </span>

                    </div>


                    <div class="d-flex flex-wrap gap-3">

                        <a asp-controller="AdminAccount"
                           asp-action="VerifyMobile"
                           class="mm-admin-reset-button">
                            ← Back
                        </a>

                        <button type="submit"
                                class="mm-admin-filter-button">
                            Verify Mobile
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}